# Copy to .env and fill in real values. Never commit .env.

# Postgres — read by both docker-compose.yml and app/config.py
POSTGRES_USER=serviceagent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=serviceagent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Use "require" for Neon or any hosted Postgres; "prefer" for the local Docker DB.
POSTGRES_SSLMODE=prefer

# OpenAI API — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_FAST_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Who creates embeddings. Must match how the manuals were ingested; re-run
# `python -m app.rag.ingest` after changing it. Use openai on any deployed server
# (ollama only works where an Ollama server is reachable).
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai

# LangSmith tracing — https://smith.langchain.com (Settings → API Keys)
# Tracing is on only when LANGSMITH_TRACING=true AND LANGSMITH_API_KEY is set.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=service-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# App
APP_ENV=development
LOG_LEVEL=INFO
